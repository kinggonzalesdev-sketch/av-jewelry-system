# ---------------------------------------------------------------------------
# A.V. Jewelry Operations System — ignore rules
# Secrets are never committed (ADR §11, Bible §30.15, §33 r14).
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
build/
dist/

# Secrets / environment
# .env.example is the ONLY env file that may be committed (placeholders only).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
service-account*.json

# Supabase local runtime state (never commit local DB dumps or linked project refs)
supabase/.branches/
supabase/.temp/
supabase/.env
.branches/
.temp/

# Test / coverage output
coverage/
.vitest/
test-results/
playwright-report/
blob-report/

# Caches
.eslintcache
.cache/
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Vercel
.vercel
