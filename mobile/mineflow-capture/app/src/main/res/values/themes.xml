<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App theme (MineFlow brand: black surface, ivory text, gold accent). -->
    <style name="Theme.MineFlowCapture" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">#C9A227</item>
        <item name="colorOnPrimary">#111111</item>
        <item name="android:colorBackground">#0B0B0B</item>
        <item name="colorSurface">#141414</item>
        <item name="colorOnSurface">#F5EFE0</item>
    </style>

    <!-- Transparent theme for the MediaProjection-consent activity. -->
    <style name="Theme.Transparent" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
