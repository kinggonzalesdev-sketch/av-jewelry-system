<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the MineFlow backend (HTTPS only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Floating "Capture Mine" button drawn over other apps (incl. Facebook). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service that keeps the overlay + capture alive. The always-on
         floating button runs as a SPECIAL_USE FGS; the service is promoted to the
         MEDIA_PROJECTION type only while a capture is in progress (Android 14 rule:
         a mediaProjection FGS may not start before projection consent is granted). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The persistent capture notification (runtime-requested on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Restart order-sticker printing after a reboot. Before this, a phone that restarted
         overnight polled nothing until someone reopened the app, and staff kept clicking Print
         into a void. The receiver only restores a state the operator already chose (signed in +
         printer configured) — it never signs in or starts a capture. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Native Bluetooth for the thermal/label printer (Classic SPP/RFCOMM). Legacy
         permissions are capped at API 30; Android 12+ uses the runtime SCAN/CONNECT
         permissions. neverForLocation on SCAN means no location permission is needed. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MineFlowCapture">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.LoginActivity" android:exported="false" />
        <activity android:name=".ui.SetupActivity" android:exported="false" />

        <!-- Phase 1 capture: screenshot preview (Retake / Save Draft / Discard). -->
        <activity android:name=".ui.PreviewActivity" android:exported="false" />

        <!-- Reserved for a later phase (order creation + send); not in the capture
             flow yet. Kept registered so it still builds. -->
        <activity android:name=".ui.ReviewActivity" android:exported="false" />

        <!-- Transparent activity used ONLY to obtain MediaProjection consent; it
             hands the grant to the service and finishes immediately. -->
        <activity
            android:name=".capture.CapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Transparent" />

        <!-- The overlay + capture foreground service. It hosts the floating button
             as a specialUse FGS and is promoted to mediaProjection only during an
             actual capture (see OverlayCaptureService). Both types are declared. -->
        <service
            android:name=".capture.OverlayCaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating on-demand screen-capture button for A.V. Jewelry order encoding over the Facebook app." />
        </service>

        <!-- Reboot survival. QUICKBOOT_POWERON is included because some OEM ROMs send only that.
             The service is started as SPECIAL_USE (never mediaProjection, which Android 14+ forbids
             starting from BOOT_COMPLETED); if the start is refused anyway the receiver degrades to
             a tappable notification rather than crashing. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <!-- Both of these are PROTECTED broadcasts: only the system can send them. An earlier
                 draft also listed QUICKBOOT_POWERON, which is NOT protected — any app could have
                 sent it here and started our foreground service. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
